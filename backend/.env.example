# Copy this file to .env in the backend/ directory before running `cargo run`.

# Required — the backend panics on startup without this.
JWT_SECRET=dev-only-change-this-to-a-long-random-string-before-production

# Optional — defaults shown
DATABASE_URL=sqlite://chess_king.db
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
PORT=8080

# SMTP (leave blank in dev — email sends will just fail silently in logs)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# 587 = STARTTLS (default, most Gmail-App-Password setups). Use 465 for implicit TLS if 587 is blocked.
SMTP_PORT=587

# Payment gateways (leave blank in dev — see wallet/gateway.rs stubs)
JAZZCASH_API_KEY=
EASYPAISA_API_KEY=
GOOGLEPAY_API_KEY=

# Frontend origin, used to build links inside emails (verify, reset, etc.)
FRONTEND_BASE_URL=http://localhost:5173
